# ── Athena ────────────────────────────────────────────────────────────────
# cp .env.example .env  and fill in every CHANGE_ME.
# Generate secrets with:  openssl rand -hex 32

# Where bind-mounted data lives. Defaults to ./data so the stack runs
# unmodified after a clone.
ATHENA_DATA_DIR=./data
TZ=UTC

# Name shown on the login page and in the dashboard header.
ATHENA_INSTANCE_NAME=Athena

# ── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_USER=athena
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=wiki
# Athena's own database (events, metrics). Created automatically.
ATHENA_DB=athena

# ── Wiki.js ───────────────────────────────────────────────────────────────
# Create the API token in Wiki.js: Administration → API → Enable + New Token.
WIKI_API_TOKEN=CHANGE_ME
# Content locale of your wiki.
WIKI_LOCALE=en

# ── MCP ───────────────────────────────────────────────────────────────────
# Bearer token for header-auth clients (Cursor) AND the password for the
# browser login used by Claude.ai's OAuth connector flow.
MCP_TOKEN=CHANGE_ME
# Public https origin of the MCP server. No path, no trailing /mcp.
MCP_PUBLIC_URL=https://athena-mcp.example.com

# ── Dashboard ─────────────────────────────────────────────────────────────
DASHBOARD_TOKEN=CHANGE_ME

# ── Embeddings ────────────────────────────────────────────────────────────
# The model runs in its own container on CPU. Changing the model re-indexes
# every page, because vectors from two models cannot be compared.
#
# Vectors are stored in Postgres via pgvector, so they are covered by the same
# backup as everything else and there is no separate vector database to run.
EMBEDDINGS_MODEL=intfloat/multilingual-e5-small

# ── Backups ───────────────────────────────────────────────────────────────
# The backup container takes an hourly pg_dump of both databases, checks each
# dump is readable, keeps a local copy, and pushes to any rclone destination.
#
# One dump is a complete backup: Wiki.js keeps pages, history, users,
# permissions, settings and every uploaded file in Postgres, and Athena keeps
# the activity log and the search vectors there too.
BACKUP_ENABLED=true
BACKUP_CRON=0 * * * *
BACKUP_KEEP_LOCAL_DAYS=7
BACKUP_KEEP_REMOTE_DAYS=30

# Where to push. Leave empty to keep backups on this host only.
# Format is <remote>:<path>, using one of the remotes defined below.
#   BACKUP_REMOTE=s3:my-bucket/athena
#   BACKUP_REMOTE=crypt:                 encrypted, see below
BACKUP_REMOTE=

# An S3-compatible destination. Works with AWS, Backblaze B2, Wasabi, MinIO,
# Hetzner and others; set the endpoint for anything that is not AWS.
RCLONE_CONFIG_S3_TYPE=s3
RCLONE_CONFIG_S3_PROVIDER=
RCLONE_CONFIG_S3_ACCESS_KEY_ID=
RCLONE_CONFIG_S3_SECRET_ACCESS_KEY=
RCLONE_CONFIG_S3_REGION=
RCLONE_CONFIG_S3_ENDPOINT=

# Optional client-side encryption. Point BACKUP_REMOTE at crypt: and the
# destination only ever receives ciphertext, including the file names.
# Generate both values with:  rclone obscure "$(openssl rand -hex 32)"
RCLONE_CONFIG_CRYPT_TYPE=
RCLONE_CONFIG_CRYPT_REMOTE=s3:my-bucket/athena
RCLONE_CONFIG_CRYPT_PASSWORD=
RCLONE_CONFIG_CRYPT_PASSWORD2=
