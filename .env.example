# ── Athena ────────────────────────────────────────────────────────────────
# cp .env.example .env  and fill in every CHANGE_ME.
# Generate secrets with:  openssl rand -hex 32

# Where bind-mounted data lives. Defaults to ./data so the stack runs
# unmodified after a clone.
ATHENA_DATA_DIR=./data
TZ=UTC

# Name shown on the login page and in the dashboard header.
ATHENA_INSTANCE_NAME=Athena

# ── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_USER=athena
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=wiki
# Athena's own database (events, metrics). Created automatically.
ATHENA_DB=athena

# ── Wiki.js ───────────────────────────────────────────────────────────────
# Create the API token in Wiki.js: Administration → API → Enable + New Token.
WIKI_API_TOKEN=CHANGE_ME
# Content locale of your wiki.
WIKI_LOCALE=en

# ── MCP ───────────────────────────────────────────────────────────────────
# Bearer token for header-auth clients (Cursor) AND the password for the
# browser login used by Claude.ai's OAuth connector flow.
MCP_TOKEN=CHANGE_ME
# Public https origin of the MCP server. No path, no trailing /mcp.
MCP_PUBLIC_URL=https://athena-mcp.example.com

# ── Dashboard ─────────────────────────────────────────────────────────────
DASHBOARD_TOKEN=CHANGE_ME

# ── Embeddings ────────────────────────────────────────────────────────────
# Text Embeddings Inference container. Change the model in docker-compose.yml.
EMBEDDINGS_URL=http://embeddings:80
EMBEDDINGS_MODEL=intfloat/multilingual-e5-small

# ── Backups ───────────────────────────────────────────────────────────────
# Athena does not run its own backup job. Configure it in Wiki.js under
# Administration → Storage, which can mirror every page to Git, S3, Azure or a
# local path continuously.
#
# That covers page content. The Postgres database also holds users, permissions
# and Athena's activity log, so keep a periodic pg_dump of it as well.
