{
  "name": "athena",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun test",
    "typecheck": "tsc --build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "mcp": "bun run --cwd packages/mcp dev",
    "indexer": "bun run --cwd packages/indexer dev",
    "dashboard": "bun run --cwd packages/dashboard dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0",
    "@types/express": "^5.0.0"
  }
}
